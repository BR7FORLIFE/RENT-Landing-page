---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-recortado.png';
import phoneRegister from '../assets/celular/1.jpeg';
import phoneMenu from '../assets/celular/2.jpeg';
import phoneLogin from '../assets/celular/3.jpeg';

const nav = [
	['Funciones', '#funciones'],
	['La app', '#app'],
	['Para cada rol', '#roles'],
	['Ventajas', '#ventajas'],
	['Preguntas', '#faq'],
];

const before = [
	'Cobros y recordatorios hechos a mano',
	'Contratos en carpetas, correos y chats',
	'Quejas por llamada, sin seguimiento',
	'Dudas sobre quién debe qué y desde cuándo',
];
const withRent = [
	'Estados de cuenta claros y mora calculada automáticamente',
	'Contratos y anexos organizados, con historial de versiones',
	'Solicitudes con ticket y estados que todos pueden ver',
	'Avisos automáticos a cada arrendatario',
];

const modules = [
	['Propiedades y arrendatarios', 'Registra cada inmueble con su información legal y su propietario, y a cada arrendatario con sus datos de contacto. Todo queda vinculado y a mano, y puedes dar a conocer los inmuebles disponibles.', 'M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V11z'],
	['Finanzas claras', 'Canon por vivienda, fechas de vencimiento y de pago, estados de cuenta por arriendo, administración, servicios públicos y parqueadero. La mora se calcula sola.', 'M3 7h18v12H3zM3 11h18M7 15h3'],
	['Contratos y documentos', 'Guarda contratos, anexos, pólizas y actas en PDF, con firma digital, historial de versiones, fechas de inicio y fin, renovación y revocación.', 'M7 3h8l4 4v14H7zM14 3v5h5M10 13h6M10 17h6'],
	['Avisos al instante', 'Notificaciones por email, SMS, WhatsApp y push: recordatorios de pago, cortes de agua, mantenimientos, asambleas y cambios de administración.', 'M6 9a6 6 0 0 1 12 0c0 6 2 7 2 7H4s2-1 2-7zM10 20a2 2 0 0 0 4 0'],
	['Solicitudes con seguimiento', 'El arrendatario crea un ticket en segundos, con categoría, prioridad y archivos adjuntos. Ve cómo avanza y recibe un aviso cuando se resuelve.', 'M4 5h16v11H9l-5 4z'],
	['Roles y permisos', 'Administrador, arrendador, arrendatario, abogado y soporte cada uno ve lo que le corresponde. Una misma cuenta puede tener varios roles.', 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4'],
];

const screens = [
	[phoneRegister, 'Registro de inmuebles', 'Registra una propiedad en pocos pasos, con fotos y datos legales, sin papeleo.', 'Pantalla de registro de inmueble de la app RENT'],
	[phoneMenu, 'Todo en un menú', 'Propiedades, contratos, finanzas, servicios y facturas, siempre a un toque.', 'Menú principal de la app RENT con propiedades, miembros y notificaciones'],
	[phoneLogin, 'Acceso seguro', 'Entra con tu correo o con Google y gestiona tus propiedades y contratos.', 'Pantalla de inicio de sesión de la app RENT'],
];

const roles = {
	Arrendatario: ['Quien vive en el inmueble tiene su arriendo claro y a un toque: cuánto debe, qué documentos tiene y cómo va cada solicitud.', ['Consulta sus contratos vigentes', 'Revisa su estado de cuenta, deudas e historial de pagos', 'Descarga documentos, facturas y recibos', 'Recibe notificaciones y comunicados', 'Crea y sigue sus solicitudes PQRS mediante tickets']],
	Arrendador: ['Quien es dueño del inmueble sabe en todo momento cómo van sus propiedades y sus ingresos.', ['Ve sus propiedades y arrendatarios', 'Consulta pagos recibidos y pendientes', 'Accede a contratos y anexos', 'Sigue el estado de mantenimientos', 'Recibe avisos de cambios importantes']],
	Administrador: ['Quien gestiona el edificio o conjunto organiza cobros, avisos y solicitudes desde un solo lugar.', ['Registra propiedades y arrendatarios', 'Emite estados de cuenta y controla la mora', 'Envía comunicados y avisos masivos', 'Atiende y asigna tickets', 'Gestiona miembros y permisos']],
	Abogado: ['Quien asesora legalmente accede a los documentos que necesita, sin pedirlos por correo.', ['Consulta contratos con su historial de versiones', 'Revisa anexos, pólizas y actas', 'Verifica fechas de inicio, fin y renovación', 'Apoya procesos de revocación', 'Accede solo a lo que le corresponde']],
	Soporte: ['Quien da soporte atiende dudas y problemas de la plataforma con el contexto a la mano.', ['Atiende solicitudes de los usuarios', 'Revisa el estado de los tickets', 'Ayuda con accesos y roles', 'Da seguimiento hasta el cierre', 'Escala casos cuando hace falta']],
};

const benefits = [
	['Todo en un solo lugar', 'Propiedades, arrendatarios, contratos y obligaciones centralizados y al día.'],
	['Menos trabajo manual', 'Recordatorios, mora y avisos automáticos para dedicar el tiempo a lo importante.'],
	['Respuestas más rápidas', 'Cada solicitud llega al responsable correcto y avanza con estados claros.'],
	['Más transparencia', 'Arrendadores y arrendatarios consultan deudas, pagos y documentos cuando quieran.'],
	['Información trazable', 'Historial de versiones y de cada gestión para saber qué pasó y quién lo hizo.'],
	['Hecho para el celular', 'Consulta y gestiona desde donde estés, sin computador ni papeles.'],
];

const steps = [
	['Registra', 'Da de alta los inmuebles, los propietarios y los arrendatarios.'],
	['Carga el contrato', 'Sube los documentos, firma digitalmente y define canon y vencimientos.'],
	['Controla y avisa', 'Sigue pagos y mora, y envía recordatorios y comunicados.'],
	['Atiende', 'Resuelve cada ticket hasta cerrarlo y avisa al arrendatario.'],
];

const faqs = [
	['¿Quién puede usar RENT?', 'Administradores, arrendadores, arrendatarios, abogados y personal de soporte. Cada uno ve únicamente lo que le corresponde según su rol.'],
	['¿Una persona puede tener más de un rol?', 'Sí. Una misma cuenta puede tener varios roles, por ejemplo arrendador en un inmueble y arrendatario en otro.'],
	['¿Cómo me entero de avisos y recordatorios?', 'RENT envía notificaciones por email, SMS, WhatsApp y push para pagos, cortes de servicios, mantenimientos y comunicados.'],
	['¿Qué pasa con los contratos y documentos?', 'Se guardan en PDF con firma digital, historial de versiones, fechas de inicio y fin, renovación y revocación.'],
	['¿Cómo sé en qué va mi solicitud?', 'Cada solicitud es un ticket con estado visible. Recibes un aviso cuando avanza o se resuelve.'],
];
---

<Layout>
	<header class="topbar">
		<div class="container topbar-inner">
			<a href="#" class="brand" aria-label="RENT">
				<Image src={logo} alt="" width={36} height={36} />
				<span>RENT</span>
			</a>
			<nav aria-label="Principal">
				{nav.map(([label, href]) => <a href={href}>{label}</a>)}
			</nav>
		</div>
	</header>

	<main>
		<section class="hero">
			<div class="container hero-grid">
				<div>
					<h1>Tus arriendos, bien administrados, desde el celular.</h1>
					<p class="lead">
						RENT reúne propiedades, contratos, pagos, avisos y solicitudes en una sola app.
						Menos papeleo y más claridad para administradores, arrendadores y arrendatarios.
					</p>
					<div class="actions">
						<a href="#cta" class="btn btn-primary">Descargar la app →</a>
						<a href="#funciones" class="btn btn-outline">Ver qué incluye</a>
					</div>
					<ul class="checks">
						<li>Contratos y documentos</li>
						<li>Pagos y mora</li>
						<li>Solicitudes con seguimiento</li>
					</ul>
				</div>
				<div class="hero-visual">
					<div class="halo"></div>
					<div class="phone phone-lg">
						<Image src={phoneMenu} alt="Menú principal de la app RENT" widths={[300, 420]} sizes="280px" loading="eager" />
					</div>
					<div class="float-card float-a"><strong>Pago registrado</strong><span>Arriendo · $1.550.000</span></div>
					<div class="float-card float-b"><strong>Aviso enviado</strong><span>Mantenimiento programado</span></div>
				</div>
			</div>
		</section>

		<section class="section change">
			<div class="container">
				<p class="eyebrow">El cambio</p>
				<h2>De carpetas y chats sueltos a una sola app</h2>
				<p class="lead">Administrar inmuebles en arriendo no debería depender de procesos manuales, intermediarios ni respuestas que tardan días.</p>
				<div class="compare">
					<div class="card before">
						<h3>Antes</h3>
						<ul>{before.map((t) => <li class="x">{t}</li>)}</ul>
					</div>
					<div class="card after">
						<h3>Con RENT</h3>
						<ul>{withRent.map((t) => <li class="ok">{t}</li>)}</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="funciones">
			<div class="container">
				<p class="eyebrow">Todo lo que incluye</p>
				<h2>Seis módulos que cubren todo el ciclo del arriendo</h2>
				<p class="lead">Desde registrar el inmueble hasta resolver una solicitud, cada paso queda conectado y con historial.</p>
				<div class="grid-3">
					{modules.map(([title, text, path]) => (
						<article class="card module">
							<span class="icon">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path} /></svg>
							</span>
							<h3>{title}</h3>
							<p>{text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section app" id="app">
			<div class="container center">
				<p class="eyebrow">La app</p>
				<h2>Así se ve en tu celular</h2>
				<p class="lead">Pantallas pensadas para consultar, pagar a tiempo y pedir ayuda en pocos toques.</p>
				<div class="screens">
					{screens.map(([img, title, text, alt]) => (
						<figure>
							<div class="phone"><Image src={img as ImageMetadata} alt={alt as string} widths={[240, 360]} sizes="(min-width: 800px) 280px, 70vw" /></div>
							<figcaption><strong>{title}</strong><span>{text}</span></figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<section class="section roles" id="roles">
			<div class="container">
				<p class="eyebrow light">Para cada rol</p>
				<h2>Cada persona ve lo que necesita</h2>
				<p class="lead">Elige un rol y mira qué puede hacer en RENT. Si alguien es arrendador de un inmueble y arrendatario de otro, usa una sola cuenta para ambos.</p>
				<div class="tabs" role="tablist">
					{Object.keys(roles).map((r, i) => (
						<button role="tab" type="button" class:list={['tab', { active: i === 0 }]} aria-selected={i === 0} data-role={r}>{r}</button>
					))}
				</div>
				{Object.entries(roles).map(([r, [intro, items]], i) => (
					<div class="role-panel" role="tabpanel" data-panel={r} hidden={i !== 0}>
						<div>
							<h3>{r}</h3>
							<p>{intro}</p>
						</div>
						<ul>{(items as string[]).map((t) => <li>{t}</li>)}</ul>
					</div>
				))}
			</div>
		</section>

		<section class="section" id="ventajas">
			<div class="container">
				<p class="eyebrow">Ventajas</p>
				<h2>Por qué administrar con RENT</h2>
				<p class="lead">Más control para quien administra y más tranquilidad para quien vive en el inmueble.</p>
				<div class="grid-3 benefits">
					{benefits.map(([title, text]) => (
						<div class="benefit">
							<span class="icon small"></span>
							<div><h3>{title}</h3><p>{text}</p></div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section steps">
			<div class="container">
				<p class="eyebrow">Cómo funciona</p>
				<h2>Cuatro pasos para tener todo en orden</h2>
				<div class="grid-4">
					{steps.map(([title, text], i) => (
						<div class="card step">
							<span class="num">{i + 1}</span>
							<h3>{title}</h3>
							<p>{text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section faq" id="faq">
			<div class="container narrow">
				<p class="eyebrow">Preguntas frecuentes</p>
				<h2>Lo que suelen preguntar</h2>
				<div class="faq-list">
					{faqs.map(([q, a]) => (
						<details><summary>{q}</summary><p>{a}</p></details>
					))}
				</div>
			</div>
		</section>

		<section class="cta" id="cta">
			<div class="container cta-inner">
				<Image src={logo} alt="RENT, sistema integrado de arrendamiento" width={160} height={160} />
				<div>
					<h2>Lleva la administración de tus arriendos en el bolsillo</h2>
					<p>Conoce RENT y simplifica pagos, contratos, avisos y solicitudes desde tu celular.</p>
					<a href="#" class="btn btn-light">Descargar la app →</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-inner">
			<span><strong>RENT</strong> Sistema integrado de arrendamiento</span>
			<span>© {new Date().getFullYear()} RENT. Todos los derechos reservados.</span>
		</div>
	</footer>
</Layout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
	const panels = document.querySelectorAll<HTMLElement>('.role-panel');
	tabs.forEach((tab) =>
		tab.addEventListener('click', () => {
			tabs.forEach((t) => {
				const on = t === tab;
				t.classList.toggle('active', on);
				t.setAttribute('aria-selected', String(on));
			});
			panels.forEach((p) => (p.hidden = p.dataset.panel !== tab.dataset.role));
		}),
	);
</script>

<style>
	.topbar { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
	.topbar-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
	.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.1rem; }
	.brand img { border-radius: 8px; }
	.topbar nav { display: flex; gap: 28px; font-size: .9rem; color: var(--muted); }
	.topbar nav a:hover { color: var(--teal); }

	.hero { background: linear-gradient(180deg, #e6f2f1, #f4f8f8); padding: 72px 0 96px; }
	.hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
	.hero h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 22px 0 18px; color: var(--navy); }
	.pill { display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: .8rem; color: var(--teal-dark); font-weight: 500; }
	.pill i { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); }
	.actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
	.checks { list-style: none; padding: 0; margin: 24px 0 0; display: flex; gap: 20px; flex-wrap: wrap; font-size: .85rem; color: var(--muted); }
	.checks li::before { content: '✓ '; color: var(--teal); font-weight: 700; }

	.hero-visual { position: relative; display: grid; place-items: center; min-height: 520px; }
	.halo { position: absolute; width: 380px; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #bfe0dc, transparent 70%); }
	.phone { position: relative; border: 7px solid var(--navy-deep); border-radius: 34px; overflow: hidden; background: #fff; box-shadow: 0 24px 50px -18px rgba(14,39,72,.45); }
	.phone img { width: 100%; }
	.phone-lg { width: 250px; }
	.float-card { position: absolute; background: #fff; border-radius: 12px; padding: 10px 14px; box-shadow: 0 12px 30px -10px rgba(14,39,72,.3); display: grid; font-size: .8rem; }
	.float-card span { color: var(--muted); font-size: .72rem; }
	.float-a { top: 70px; left: 0; }
	.float-b { bottom: 80px; right: 0; }

	.card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
	.compare { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; }
	.compare h3 { margin-bottom: 18px; font-size: 1.2rem; }
	.compare ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
	.compare li { padding-left: 26px; position: relative; font-size: .95rem; }
	.compare li::before { position: absolute; left: 0; font-weight: 700; }
	.before { background: var(--bg); }
	.x::before { content: '×'; color: #d9622b; }
	.after { background: linear-gradient(135deg, var(--teal-dark), #14867d); color: #fff; border: 0; }
	.ok::before { content: '✓'; color: #8fe3d8; }

	.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
	.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
	.module h3 { font-size: 1.1rem; margin: 18px 0 10px; }
	.module p, .step p, .benefit p { color: var(--muted); font-size: .9rem; }
	.icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--teal-soft); color: var(--teal); }
	.icon.small { width: 40px; height: 40px; flex: none; position: relative; }
	.icon.small::after { content: ''; width: 14px; height: 14px; border-radius: 50%; border: 2.5px solid var(--teal); }

	.app { background: linear-gradient(180deg, #f4f8f8, #e6f2f1); }
	.center { text-align: center; }
	.center h2, .center .lead { margin-inline: auto; }
	.screens { display: grid; grid-template-columns: repeat(3, minmax(0, 280px)); justify-content: center; gap: 40px; margin-top: 48px; }
	.screens figure { margin: 0; }
	.screens figcaption { display: grid; gap: 6px; margin-top: 20px; }
	.screens figcaption span { color: var(--muted); font-size: .88rem; }

	.roles { background: var(--navy); color: #fff; }
	.roles .lead { color: #b9c8de; }
	.eyebrow.light { color: #6fd3c7; }
	.tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 32px 0 28px; }
	.tab { font: inherit; font-size: .9rem; padding: 9px 20px; border-radius: 999px; border: 1px solid rgba(255,255,255,.25); background: transparent; color: #fff; cursor: pointer; }
	.tab.active { background: #fff; color: var(--navy); font-weight: 700; }
	.role-panel { display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: start; }
	.role-panel[hidden] { display: none; }
	.role-panel h3 { font-size: 1.3rem; margin-bottom: 10px; }
	.role-panel p { color: #b9c8de; }
	.role-panel ul { list-style: none; margin: 0; padding: 28px; border-radius: var(--radius); background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); display: grid; gap: 14px; font-size: .92rem; }
	.role-panel li::before { content: '✓'; display: inline-grid; place-items: center; width: 20px; height: 20px; margin-right: 10px; border-radius: 50%; background: var(--teal); font-size: .7rem; }

	.benefits { gap: 36px 28px; }
	.benefit { display: flex; gap: 14px; }
	.benefit h3 { font-size: 1rem; margin-bottom: 6px; }

	.steps { background: var(--bg); }
	.step h3 { margin: 16px 0 8px; font-size: 1.05rem; }
	.num { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--teal); color: #fff; font-weight: 700; }

	.narrow { max-width: 760px; }
	.faq-list { margin-top: 32px; display: grid; }
	details { border-bottom: 1px solid var(--line); padding: 18px 0; }
	summary { cursor: pointer; font-weight: 700; list-style: none; }
	summary::-webkit-details-marker { display: none; }
	summary::before { content: '▸'; margin-right: 12px; color: var(--teal); display: inline-block; transition: transform .2s; }
	details[open] summary::before { transform: rotate(90deg); }
	details p { margin-top: 10px; color: var(--muted); padding-left: 26px; }

	.cta { background: var(--navy); color: #fff; padding: 72px 0; }
	.cta-inner { display: flex; align-items: center; gap: 40px; }
	.cta-inner img { border-radius: 28px; flex: none; }
	.cta h2 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); max-width: 22ch; }
	.cta p { color: #b9c8de; margin: 14px 0 24px; }
	.footer { background: var(--navy-deep); color: #b9c8de; font-size: .82rem; padding: 18px 0; }
	.footer-inner { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
	.footer strong { color: #fff; margin-right: 8px; }

	@media (max-width: 900px) {
		.topbar nav { display: none; }
		.hero-grid, .compare, .role-panel { grid-template-columns: 1fr; }
		.grid-3 { grid-template-columns: 1fr 1fr; }
		.grid-4 { grid-template-columns: 1fr 1fr; }
	}
	@media (max-width: 640px) {
		.section { padding: 64px 0; }
		.grid-3, .grid-4, .screens { grid-template-columns: 1fr; }
		.screens { justify-items: center; }
		.cta-inner { flex-direction: column; text-align: center; }
		.float-card { display: none; }
	}
</style>
