---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'RENT | Sistema integrado de arrendamiento',
	description = 'RENT reúne propiedades, contratos, pagos, avisos y solicitudes en una sola app para administradores, arrendadores y arrendatarios.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/rent.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--navy: #12305a;
		--navy-deep: #0e2748;
		--teal: #0f766e;
		--teal-dark: #115e59;
		--teal-soft: #e3f1ef;
		--bg: #f4f8f8;
		--ink: #12263f;
		--muted: #5b6b7d;
		--line: #dde6e8;
		--radius: 16px;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		font-family: 'DM Sans', system-ui, sans-serif;
		color: var(--ink);
		background: #fff;
		line-height: 1.55;
	}
	h1,
	h2,
	h3,
	p {
		margin: 0;
	}
	h1,
	h2,
	h3 {
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	img {
		max-width: 100%;
		height: auto;
		display: block;
	}
	.container {
		width: min(1120px, 100% - 40px);
		margin-inline: auto;
	}
	.eyebrow {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--teal);
		margin-bottom: 14px;
	}
	.section {
		padding: 88px 0;
	}
	.section h2 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		max-width: 20ch;
	}
	.lead {
		color: var(--muted);
		margin-top: 14px;
		max-width: 56ch;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 13px 22px;
		border-radius: 12px;
		font-weight: 700;
		font-size: 0.95rem;
		border: 1px solid transparent;
		transition: transform 0.15s, background 0.15s;
		cursor: pointer;
	}
	.btn:hover {
		transform: translateY(-1px);
	}
	.btn-primary {
		background: var(--teal);
		color: #fff;
	}
	.btn-primary:hover {
		background: var(--teal-dark);
	}
	.btn-outline {
		background: #fff;
		border-color: var(--line);
		color: var(--ink);
	}
	.btn-light {
		background: #fff;
		color: var(--navy);
	}
	:focus-visible {
		outline: 3px solid var(--teal);
		outline-offset: 2px;
	}
</style>
